#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "httpx",
# ]
# ///

import argparse
import ssl
import subprocess
import sys
from pathlib import Path

import httpx


API_URL = "https://gist.gitcodo.hub/api/gists"
TOKEN_NAME = "gist.gitcodo.hub.token"


HELP = """\
Usage:
  tea-gist <command> [options]

Commands:
  add       Create a new gist
  edit      Edit an existing gist
  delete    Delete a gist
  list      List gists

Run 'tea-gist <command> --help' for command-specific help.
"""

ADD_HELP = """\
Usage:
  tea-gist add [options] <file ...>

Create a new gist from one or more files.

Options:
  -t, --title TEXT          Gist title
  -d, --description TEXT    Gist description
      --private             Create a private gist
  -h, --help                Show this help

Examples:
  tea-gist add README.md
  tea-gist add -t "Bluetooth Notes" bt-key.md
  tea-gist add --private bt-key.md
"""

EDIT_HELP = """\
Usage:
  tea-gist edit [options] <gist>

Edit an existing gist.

Arguments:
  gist                      Gist URL suffix or ID

Options:
  -t, --title TEXT          Set gist title
  -d, --description TEXT    Set gist description
      --private             Make gist private
      --public              Make gist public
  -h, --help                Show this help

Examples:
  tea-gist edit bluetooth-notes -t "Bluetooth Key Notes"
  tea-gist edit 0ec2f0f051e64e29a1dd5cbf8e703151 -d "Updated notes"
"""

DELETE_HELP = """\
Usage:
  tea-gist delete <gist>

Delete an existing gist.

Arguments:
  gist                      Gist URL suffix or ID

Examples:
  tea-gist delete bluetooth-notes
  tea-gist delete 0ec2f0f051e64e29a1dd5cbf8e703151
"""

LIST_HELP = """\
Usage:
  tea-gist list [options] [username]

List gists on a single page.
Page 1 and 30 gists per page are used by default.

Arguments:
  username                  Optional username to filter by

Options:
      --page PAGENUM        Page number (default: 1)
      --per-page NUM        Number of gists per page (default: 30)
  -h, --help                Show this help

Examples:
  tea-gist list
  tea-gist list --page 2
  tea-gist list --per-page 10
  tea-gist list --page 2 --per-page 10
  tea-gist list jason
"""


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.exit(2, f"tea-gist: {message}\n")


def get_token() -> str:
    result = subprocess.run(
        ["pass", "show", TOKEN_NAME],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.splitlines()[0]


def ca_bundle() -> str | bool:
    paths = ssl.get_default_verify_paths()

    if paths.cafile:
        return paths.cafile

    return True


def request(
    method: str,
    url: str,
    *,
    json: dict | None = None,
    params: dict | None = None,
) -> httpx.Response:
    token = get_token()

    return httpx.request(
        method,
        url,
        json=json,
        params=params,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
        },
        verify=ca_bundle(),
        timeout=30,
    )


def show_response(response: httpx.Response) -> None:
    if response.is_success:
        if not response.content:
            return

        try:
            data = response.json()
        except ValueError:
            print(response.text)
            return

        if isinstance(data, dict):
            url = data.get("html_url") or data.get("url")
            if url:
                print(url)
                return

        print(response.text)
        return

    print(
        f"tea-gist: OpenGist returned HTTP {response.status_code}",
        file=sys.stderr,
    )

    if response.text:
        print(response.text, file=sys.stderr)


def gist_url(gist: str) -> str:
    return f"{API_URL}/{gist}"


def parser_for(command: str) -> Parser:
    parser = Parser(add_help=False)

    if command == "add":
        parser.add_argument("-t", "--title")
        parser.add_argument("-d", "--description")
        parser.add_argument("--private", action="store_true")
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("files", nargs="+")
    elif command == "edit":
        parser.add_argument("-t", "--title")
        parser.add_argument("-d", "--description")
        parser.add_argument("--private", action="store_true")
        parser.add_argument("--public", action="store_true")
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("gist")
    elif command == "delete":
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("gist")
    elif command == "list":
        parser.add_argument("-h", "--help", action="store_true")
        parser.add_argument("--page", type=int, default=1)
        parser.add_argument("--per-page", type=int, default=30)
        parser.add_argument("username", nargs="?")
    else:
        raise ValueError(command)

    return parser


def add(args: argparse.Namespace) -> int:
    files: dict[str, dict[str, str]] = {}

    for filename in args.files:
        path = Path(filename)

        if not path.is_file():
            print(
                f"tea-gist: file not found: {filename}",
                file=sys.stderr,
            )
            return 1

        files[path.name] = {
            "content": path.read_text(),
        }

    payload: dict = {
        "files": files,
    }

    if args.title is not None:
        payload["title"] = args.title

    if args.description is not None:
        payload["description"] = args.description

    if args.private:
        payload["visibility"] = "private"

    try:
        response = request("POST", API_URL, json=payload)
    except subprocess.CalledProcessError:
        print(
            f"tea-gist: unable to retrieve {TOKEN_NAME} from pass",
            file=sys.stderr,
        )
        return 1
    except httpx.HTTPError as exc:
        print(f"tea-gist: request failed: {exc}", file=sys.stderr)
        return 1

    show_response(response)
    return 0 if response.is_success else 1


def edit(args: argparse.Namespace) -> int:
    if args.private and args.public:
        print(
            "tea-gist: --private and --public are mutually exclusive",
            file=sys.stderr,
        )
        return 2

    payload: dict = {}

    if args.title is not None:
        payload["title"] = args.title

    if args.description is not None:
        payload["description"] = args.description

    if args.private:
        payload["visibility"] = "private"
    elif args.public:
        payload["visibility"] = "public"

    if not payload:
        print("tea-gist: nothing to edit", file=sys.stderr)
        return 2

    try:
        response = request(
            "PATCH",
            gist_url(args.gist),
            json=payload,
        )
    except subprocess.CalledProcessError:
        print(
            f"tea-gist: unable to retrieve {TOKEN_NAME} from pass",
            file=sys.stderr,
        )
        return 1
    except httpx.HTTPError as exc:
        print(f"tea-gist: request failed: {exc}", file=sys.stderr)
        return 1

    show_response(response)
    return 0 if response.is_success else 1


def delete(args: argparse.Namespace) -> int:
    try:
        response = request(
            "DELETE",
            gist_url(args.gist),
        )
    except subprocess.CalledProcessError:
        print(
            f"tea-gist: unable to retrieve {TOKEN_NAME} from pass",
            file=sys.stderr,
        )
        return 1
    except httpx.HTTPError as exc:
        print(f"tea-gist: request failed: {exc}", file=sys.stderr)
        return 1

    if response.is_success:
        print(f"Deleted {args.gist}")
        return 0

    show_response(response)
    return 1


def list_gists(args: argparse.Namespace) -> int:
    if args.page < 1:
        print("tea-gist: --page must be at least 1", file=sys.stderr)
        return 2

    if args.per_page < 1:
        print("tea-gist: --per-page must be at least 1", file=sys.stderr)
        return 2

    params = {
        "page": args.page,
        "per_page": args.per_page,
    }

    if args.username:
        params["username"] = args.username

    try:
        response = request(
            "GET",
            API_URL,
            params=params,
        )
    except subprocess.CalledProcessError:
        print(
            f"tea-gist: unable to retrieve {TOKEN_NAME} from pass",
            file=sys.stderr,
        )
        return 1
    except httpx.HTTPError as exc:
        print(f"tea-gist: request failed: {exc}", file=sys.stderr)
        return 1

    if not response.is_success:
        show_response(response)
        return 1

    try:
        gists = response.json()
    except ValueError:
        print(
            "tea-gist: invalid response from OpenGist",
            file=sys.stderr,
        )
        return 1

    if not isinstance(gists, list):
        print(
            "tea-gist: unexpected response from OpenGist",
            file=sys.stderr,
        )
        return 1

    if not gists:
        print("No gists found.")
        return 0

    print(f"{'URL':<60}  {'TITLE':<40}  UPDATED")
    print(f"{'-' * 60}  {'-' * 40}  {'-' * 20}")

    for gist in gists:
        url = gist.get("html_url") or ""
        title = gist.get("title") or ""
        updated = gist.get("updated_at") or gist.get("created_at") or ""

        print(f"{url:<60}  {title:<40}  {updated}")

    return 0


COMMAND_HELP = {
    "add": ADD_HELP,
    "edit": EDIT_HELP,
    "delete": DELETE_HELP,
    "list": LIST_HELP,
}

COMMANDS = {
    "add": add,
    "edit": edit,
    "delete": delete,
    "list": list_gists,
}


def main() -> int:
    if len(sys.argv) == 1 or sys.argv[1] in ("-h", "--help"):
        print(HELP)
        return 0

    command = sys.argv[1]

    if command not in COMMANDS:
        print(
            f"tea-gist: unknown command: {command}\n",
            file=sys.stderr,
        )
        print(HELP, file=sys.stderr)
        return 2

    if len(sys.argv) == 2 and command != "list":
        print(COMMAND_HELP[command])
        return 0

    parser = parser_for(command)
    args = parser.parse_args(sys.argv[2:])

    if getattr(args, "help", False):
        print(COMMAND_HELP[command])
        return 0

    return COMMANDS[command](args)


if __name__ == "__main__":
    raise SystemExit(main())

